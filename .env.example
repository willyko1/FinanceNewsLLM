# Free default: create a key at https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Optional paid OpenAI configuration:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=gpt-5.6-terra

# The SEC asks automated clients to identify themselves.
SEC_USER_AGENT=SignalDesk research@example.com

# Optional request timeout, in seconds
REQUEST_TIMEOUT_SECONDS=20
RESEARCH_TIMEOUT_SECONDS=90
MAX_TOOL_ROUNDS=4
MAX_TOOL_CALLS=12
REQUESTS_PER_DAY_PER_IP=3
GLOBAL_REQUESTS_PER_DAY=100
RESPONSE_CACHE_SECONDS=600
